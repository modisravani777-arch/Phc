DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CONN_MAX_AGE=60
# Optional local-only test database. This is never used by the application runtime.
DJANGO_TEST_DATABASE_URL=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
MEDIA_ROOT=
# Optional path to the unpacked H5 challenge data directory for offline companion APIs.
H5_DATA_DIR=
